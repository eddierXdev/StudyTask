PORT=3000
NODE_ENV=development
DATABASE_STORAGE=data/studytask.db
JWT_SECRET=
CSRF_SECRET=
JWT_EXPIRES_IN=1h
COOKIE_NAME=studytask_token
BCRYPT_ROUNDS=12

# En Vercel no se define PORT y la base debe vivir en /tmp.
# DATABASE_STORAGE se resuelve automáticamente a /tmp/studytask.db cuando
# existe la variable VERCEL; puedes sobrescribirlo si lo necesitas.

# Optional: create an administrator at startup. Define these only in the
# hosting platform (for example Vercel) or a local ignored .env file.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

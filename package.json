{
  "name": "studytask",
  "version": "0.1.0",
  "private": true,
  "description": "Gestor sencillo de tareas académicas",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:production": "npm run db:migrate && node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:smoke && npm run test:integration",
    "test:smoke": "node tests/smoke.js",
    "test:integration": "node tests/integration.js",
    "test:production": "node tests/production.js",
    "create-admin": "node scripts/createAdmin.js",
    "db:check": "node scripts/checkDatabase.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "bootstrap": "5.3.8",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.1.0",
    "dotenv": "18.0.9",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-ejs-layouts": "2.5.1",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "sequelize-cli": "6.6.5"
  }
}

<section class="auth-card card shadow-sm">
  <p class="eyebrow">Acceso</p>
  <h1 class="h3">Iniciar sesión</h1>
  <p class="auth-intro">Accede con tu cuenta para gestionar tus tareas.</p>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert alert-danger" role="alert">
      <ul class="error-list mb-0">
        <% errors.forEach((validationError) => { %>
          <li><%= validationError.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form class="auth-form" method="post" action="/login" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="mb-3">
      <label class="form-label" for="email">Correo electrónico</label>
      <input
        class="form-control"
        id="email"
        name="email"
        type="email"
        value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
        autocomplete="email"
        maxlength="255"
        required
      />
    </div>

    <div class="mb-3">
      <label class="form-label" for="password">Contraseña</label>
      <input
        class="form-control"
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      />
    </div>

    <button class="btn btn-primary w-100" type="submit">Entrar</button>
  </form>

  <p class="auth-switch text-center">
    ¿Todavía no tienes cuenta? <a href="/register">Crear una cuenta</a>
  </p>
</section>
